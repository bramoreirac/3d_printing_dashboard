# Supabase project settings (Dashboard → Project Settings → API)
# Copy this file to .env and fill in the values. Never commit .env.
# These two values are publishable (they ship in the browser bundle);
# security comes from the Row Level Security policies, not from hiding them.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Use whichever key your dashboard shows — both are accepted:
VITE_SUPABASE_ANON_KEY=YOUR-ANON-KEY
# VITE_SUPABASE_PUBLISHABLE_KEY=YOUR-PUBLISHABLE-KEY
